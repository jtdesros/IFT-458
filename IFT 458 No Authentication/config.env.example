# Copy this file to .env in the project root. Never submit your .env file.
# .env takes precedence over config.env; you only need one settings file.
NODE_ENV=development
PORT=4001
API_VERSION=/api/v1
STUDENT_NAME="Your Full Name"
STUDENT_ID="Your ten-digit ASU ID"
BCRYPT_ROUNDS=12

# Atlas: replace YOUR_CLUSTER with the host copied from Atlas Connect > Drivers.
# Keep <password> in DATABASE and put your URI-encoded database password below.
DATABASE=mongodb+srv://ift_user:<password>@YOUR_CLUSTER.mongodb.net/ift458_level1?retryWrites=true&w=majority
DATABASE_PASSWORD="REPLACE_WITH_URI_ENCODED_DATABASE_PASSWORD"

# Local MongoDB alternative: replace the DATABASE line above with this line.
# DATABASE=mongodb://127.0.0.1:27017/ift458_level1

# Optional: set false to disable public IP/geolocation lookup in the run log.
# LOG_GEO=false
